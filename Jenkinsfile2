pipeline {
    agent any

    stages {
        stage('Checkout Code') {
            steps {
                echo 'Cloning repository...'
                git branch: 'main', url: 'https://github.com/Sourav16031998/InsureMe-20Mar.git'
            }
        }

        stage('Build with Maven') {
            steps {
                echo 'Building project using Maven...'
                sh "mvn -Dmaven.test.failure.ignore=true clean package"
            }
        }

        stage('Create Docker Image') {
            steps {
                echo 'Building Docker image...'
                sh 'docker build -t sourav16031998/insure-me:1.0 .'
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockercreds', 
                    passwordVariable: 'dockerpassword', 
                    usernameVariable: 'dockerlogin'
                )]) {
                    sh "echo $dockerpassword | docker login -u $dockerlogin --password-stdin"
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                echo 'Pushing Docker image to DockerHub...'
                sh 'docker push sourav16031998/insure-me:1.0'
            }
        }

        stage('Terraform Config & Deployment') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: 'awslogin',
                    accessKeyVariable: 'AWS_ACCESS_KEY_ID',
                    secretKeyVariable: 'AWS_SECRET_ACCESS_KEY'
                ]]) {
                    script {
                        // change to dir if your terraform files are in a folder
                        // dir('terraform-files') {
                            sh 'cd cd terraform-files'
                            sh 'chmod 600 sir.pem'
                            sh 'terraform init'
                            sh 'terraform validate'
                            sh 'terraform apply -auto-approve'
                        // }
                    }
                }
            }
        }
    }
}
